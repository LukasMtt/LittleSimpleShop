{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": { "path": "./logs/log-.txt", "rollingInterval": "Day" }
      }
    ]
  },
  "AllowedHosts": "*",
  "CultureCode": "de",

  "ConnectionString": "Server=shop_sqlserver,1433;Database=shop;User Id=SA;Password=Password123!;TrustServerCertificate=true",
  "FrontendBaseUrl": "http://localhost",

  "StripePrivateKey": "",
  "StripeWebhookSecret": "",

  "SeaweedFs": {
    "FileUrl": "http://shop_seaweedfs:8080",
    "AssignUrl": "http://shop_seaweedfs:9333"
  },

  "PdfConverter": {
    "Url": "http://shop_gotenberg:3000"
  },

  "EMail": {
    "FromAddress": "shop@mail.com",
    "FromName": "Nice Shop",
    "SmtpServer": "host.docker.internal",
    "SmtpPort": 25,
    "SmtpUser": "",
    "Password": ""
  }
}
